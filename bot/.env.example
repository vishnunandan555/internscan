# ==============================================================================
# InternScan India — Telegram Bot Configuration (v2.0.0)
# ==============================================================================

# Required: Bot Token from Telegram @BotFather (e.g. 7123456789:AAHfkj...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Channel (e.g. @my_internships_channel) OR numeric Chat/Group ID (e.g. -1001234567890)
# Leave blank if you only want interactive user commands (/latest, /active) without auto-broadcast
TELEGRAM_CHAT_ID=@your_channel_or_group_id

# Poll Interval in Seconds (1800 = 30 minutes, 3600 = 1 hour)
POLL_INTERVAL_SECONDS=1800

# Optional: Custom API URL (defaults to official GitHub Pages API)
INTERNSCAN_API_URL=https://vishnunandan555.github.io/interntrack-india/api/latest.json
INTERNSCAN_ACTIVE_URL=https://vishnunandan555.github.io/interntrack-india/api/active.json
